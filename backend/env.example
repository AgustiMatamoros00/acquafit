# Configuración de la base de datos SQL Server
# Estos valores son para tu SQL Server en Docker
DB_HOST=localhost
DB_PORT=1433
DB_USER=sa
DB_PASSWORD=sapwd
DB_NAME=acquafit

# Puerto del servidor Express
PORT=3000

# Clave secreta para JWT (CÁMBIAR EN PRODUCCIÓN)
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Entorno
NODE_ENV=development

